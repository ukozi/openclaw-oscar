{
  "name": "@ukozi/openclaw-oscar",
  "version": "0.2.1",
  "description": "OpenClaw channel plugin that speaks the native OSCAR protocol to an Open OSCAR Server.",
  "license": "MIT",
  "author": "Lucas Chumley",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukozi/openclaw-oscar.git"
  },
  "homepage": "https://github.com/ukozi/openclaw-oscar#readme",
  "bugs": {
    "url": "https://github.com/ukozi/openclaw-oscar/issues"
  },
  "keywords": [
    "openclaw-plugin",
    "oscar",
    "instant-messaging"
  ],
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "assets/icon.png"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "pack:check": "vitest run test/pack.test.ts",
    "plugin:ci": "d=$(mktemp -d) && npm pack --pack-destination \"$d\" >/dev/null && mkdir -p \"$d/tree\" && tar xzf \"$d\"/*.tgz -C \"$d/tree\" --strip-components=1 && npm --prefix \"$d/tree\" install --omit=dev --no-audit --no-fund >/dev/null && plugin-inspector ci --plugin-root \"$d/tree\" --no-openclaw --runtime --mock-sdk --allow-execute"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@openclaw/plugin-inspector": "0.3.26",
    "@types/node": "22.20.4",
    "openclaw": "2026.7.1-2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./src/setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "oscar",
      "label": "OSCAR",
      "selectionLabel": "OSCAR (Open OSCAR Server)",
      "docsPath": "/channels/oscar",
      "blurb": "Native OSCAR messaging through an Open OSCAR Server."
    },
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    },
    "install": {
      "clawhubSpec": "clawhub:@ukozi/openclaw-oscar",
      "npmSpec": "@ukozi/openclaw-oscar",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.7.1-2"
    }
  }
}
